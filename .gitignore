__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# R artifacts
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.rds
*.Rds

